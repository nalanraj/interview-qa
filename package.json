{
  "name": "qa-playwright-cucumber-interview",
  "version": "1.0.0",
  "private": true,
  "description": "A deliberately imperfect Playwright and Cucumber interview exercise for QA engineers.",
  "scripts": {
    "test": "cucumber-js",
    "test:headed": "HEADLESS=false cucumber-js",
    "test:ui": "bddgen && playwright test --ui",
    "test:smoke": "cucumber-js --tags @smoke"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^11.3.0",
    "@playwright/test": "^1.63.0",
    "playwright": "^1.55.0",
    "playwright-bdd": "^9.2.1"
  }
}
